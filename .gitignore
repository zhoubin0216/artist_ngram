.DS_Store
.idea/
.tmp/
.venv/
__pycache__/
node_modules/
*.pyc

# Regenerable Ngram data: never push multi-hundred-MB shards to GitHub.
data/ngram/
outputs/ngram_*/

# Publish only the two reviewed compact datasets, not scratch/cache files.
!outputs/ngram_artists_full/
!outputs/ngram_movement_15/
outputs/ngram_artists_full/*
outputs/ngram_movement_15/*
!outputs/ngram_artists_full/artist_year_counts.jsonl
!outputs/ngram_artists_full/artists.json
!outputs/ngram_artists_full/manifest.json
!outputs/ngram_artists_full/report.json
!outputs/ngram_artists_full/totalcounts/
!outputs/ngram_artists_full/checkpoints/
!outputs/ngram_movement_15/movement_year_counts.jsonl
!outputs/ngram_movement_15/movements.json
!outputs/ngram_movement_15/manifest.json
!outputs/ngram_movement_15/report.json
!outputs/ngram_movement_15/totalcounts/
!outputs/ngram_movement_15/checkpoints/
outputs/ngram_*/totalcounts/*
!outputs/ngram_*/totalcounts/totalcounts-[1-5]
outputs/ngram_*/checkpoints/*
!outputs/ngram_*/checkpoints/*.gz.json
outputs/ngram_*/**/*.tmp
outputs/ngram_*/**/*.part
outputs/ngram_*/**/*.part.json

data/openalex_art/
data/openalex/
results/openalex/artist_work_clean.jsonl
OpenAlex_clean_handoff.zip
OpenAlex_normalized_handoff.zip

# OpenAlex movement caches and intermediate review outputs
data/openalex_movements/
config/openalex_movement_review.csv
results/openalex_movement_classification/
results/openalex_movement_context/
results/openalex_movement_context_sample/
results/openalex_movement_triage/
results/openalex_movements_auto_broad/
results/openalex_movements_auto_strict/

# Keep annual movement deliverables; exclude work-level detail
results/openalex_movements_keyword_proxy/movement_work_union.jsonl
/data/openalex_movements/

# Python test caches
.pytest_cache/

# Getty API/SPARQL responses are reproducible but may be large.
data/getty/raw/*
!data/getty/raw/.gitkeep
data/getty/full_smoke/

# Benchmark input copies, Spark event logs, and query-plan scratch files.
data/benchmark/
data/integrated/
outputs/spark-events/
outputs/benchmark_plans/
outputs/task3_query_results/
*.log

# Local secrets and machine-specific overrides.
.env
configs/*.local.yaml
